---
import { SITE } from '../config/site';
import IconBox from './ui/IconBox.astro';
---

<section id="contacto" class="py-16 sm:py-20 lg:py-24 bg-white text-neutral-900 scroll-mt-20 dark:bg-neutral-900 dark:text-neutral-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-16">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-6 text-neutral-900 dark:text-neutral-50">
          Reserva tu experiencia
        </h2>
        <p class="text-neutral-600 text-base sm:text-lg mb-8 leading-relaxed dark:text-neutral-400">
          ¿Listo para desconectar? Reserva en Airbnb o contáctanos si tienes alguna duda sobre tu
          estadía.
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <IconBox name="phone" size="sm" />
            <div>
              <p class="font-medium text-neutral-500 text-sm dark:text-neutral-400">Teléfono</p>
              <p class="text-base sm:text-lg font-semibold text-neutral-900 break-all sm:break-normal dark:text-neutral-50">
                0963373265 o 0995795884
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <IconBox name="mail" size="sm" />
            <div>
              <p class="font-medium text-neutral-500 text-sm dark:text-neutral-400">Email</p>
              <p class="text-base sm:text-lg font-semibold text-neutral-900 break-all sm:break-normal dark:text-neutral-50">
                sanfranciscoglamping@gmail.com
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col items-center justify-center bg-neutral-50 p-6 sm:p-10 rounded-3xl border border-neutral-200 dark:bg-neutral-800 dark:border-neutral-700"
      >
        <p class="text-neutral-600 text-center mb-6 max-w-sm text-base sm:text-lg dark:text-neutral-400">
          Reserva tu estadía directamente en Airbnb.
        </p>
        <a
          href={SITE.airbnbUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-airbnb-link
          data-airbnb-source="contact"
          class="inline-flex items-center justify-center w-full sm:w-auto px-10 py-4 rounded-full font-semibold text-white text-lg min-h-[52px] bg-neutral-800 hover:bg-neutral-700 transition-all hover:scale-105 shadow-lg dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
        >
          Reservar en Airbnb
        </a>
      </div>
    </div>
  </div>
</section>

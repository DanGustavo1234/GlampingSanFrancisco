---

---

<section id="contacto" class="py-24 bg-white text-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-4xl font-bold mb-6 text-neutral-900">
          Reserva tu experiencia
        </h2>
        <p class="text-neutral-600 text-lg mb-8 leading-relaxed">
          ¿Listo para desconectar? Déjanos tus datos y nos pondremos en contacto
          contigo para confirmar disponibilidad y afinar los detalles de tu
          estadía.
        </p>

        <div class="space-y-6">
          <div class="flex items-center">
            <div
              class="w-12 h-12 bg-neutral-100 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-neutral-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-neutral-500 text-sm">Teléfono</p>
              <p class="text-lg font-semibold text-neutral-900">0963373265</p>
            </div>
          </div>

          <div class="flex items-center">
            <div
              class="w-12 h-12 bg-neutral-100 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-neutral-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-neutral-500 text-sm">Email</p>
              <p class="text-lg font-semibold text-neutral-900">
                reservas@glampingsanfrancisco.com
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-3xl border border-neutral-200 shadow-xl">
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-neutral-700 mb-2"
                >Nombre completo</label
              >
              <input
                type="text"
                id="name"
                class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-colors"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-neutral-700 mb-2"
                >Email</label
              >
              <input
                type="email"
                id="email"
                class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-colors"
                placeholder="tu@email.com"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="dates"
                class="block text-sm font-medium text-neutral-700 mb-2"
                >Fechas estimadas</label
              >
              <input
                type="text"
                id="dates"
                class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-colors"
                placeholder="Ej: 15-18 de Octubre"
              />
            </div>
            <div>
              <label
                for="guests"
                class="block text-sm font-medium text-neutral-700 mb-2"
                >Huéspedes</label
              >
              <select
                id="guests"
                class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-colors appearance-none"
              >
                <option>2 personas</option>
                <option>3 personas</option>
                <option>4 personas</option>
                <option>Más de 4</option>
              </select>
            </div>
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-medium text-neutral-700 mb-2"
              >Mensaje o requerimientos especiales</label
            >
            <textarea
              id="message"
              rows="4"
              class="w-full bg-neutral-50 border border-neutral-200 rounded-xl px-4 py-3 text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-colors resize-none"
              placeholder="¿Celebras alguna ocasión especial?"></textarea>
          </div>

          <button
            type="button"
            class="w-full bg-neutral-900 hover:bg-neutral-800 text-white font-bold py-4 rounded-xl transition-colors text-lg shadow-lg hover:shadow-xl hover:scale-[1.02]"
          >
            Solicitar Reserva
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

---
import SocialIcon from './ui/SocialIcon.astro';
import { SITE } from '../config/site';

const socialLinkClass =
  'w-10 h-10 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-400 hover:text-white hover:border-neutral-500 hover:bg-neutral-800 transition-all dark:border-neutral-600 dark:hover:bg-neutral-800';
---

<footer
  class="bg-neutral-900 text-neutral-200 py-12 border-t border-neutral-800 dark:bg-black dark:border-neutral-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="col-span-1 md:col-span-2">
        <a
          href="#inicio"
          class="text-2xl font-bold text-neutral-50 tracking-tight mb-4 block"
          >Glamping San Francisco</a
        >
        <p class="text-neutral-400 max-w-sm">
          Redefiniendo el concepto de acampar. Conectamos personas con la
          naturaleza sin renunciar al confort y bienestar.
        </p>
      </div>

      <div>
        <h4
          class="text-neutral-50 font-semibold mb-4 uppercase text-sm tracking-wider"
        >
          Navegación
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="#galeria" class="hover:text-neutral-50 transition-colors"
              >Galería</a>
          </li>
          <li>
            <a href="#servicios" class="hover:text-neutral-50 transition-colors"
              >Servicios</a>
          </li>
          <li>
            <a href="#experiencias" class="hover:text-neutral-50 transition-colors"
              >Experiencias</a>
          </li>
          <li>
            <a href="#precios" class="hover:text-neutral-50 transition-colors"
              >Precios</a>
          </li>
          <li>
            <a href="#ubicacion" class="hover:text-neutral-50 transition-colors"
              >Ubicación</a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-neutral-50 transition-colors"
              >Contacto</a>
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="text-neutral-50 font-semibold mb-4 uppercase text-sm tracking-wider"
        >
          Síguenos
        </h4>
        <div class="flex gap-3">
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class={socialLinkClass}
            aria-label="Instagram"
          >
            <SocialIcon name="instagram" class="w-5 h-5" />
          </a>
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class={socialLinkClass}
            aria-label="Facebook"
          >
            <SocialIcon name="facebook" class="w-5 h-5" />
          </a>
          <a
            href={SITE.social.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class={socialLinkClass}
            aria-label="TikTok"
          >
            <SocialIcon name="tiktok" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>

    <div
      class="border-t border-neutral-800 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-neutral-500 gap-4"
    >
      <p>
        &copy; {new Date().getFullYear()} Glamping San Francisco. Todos los derechos
        reservados.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#" class="hover:text-neutral-50 transition-colors"
          >Términos de servicio</a
        >
        <a href="#" class="hover:text-neutral-50 transition-colors"
          >Política de privacidad</a
        >
      </div>
    </div>
  </div>
</footer>

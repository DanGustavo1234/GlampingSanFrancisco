---
import { SITE } from '../config/site';
import Icon from './ui/Icon.astro';

const themeToggleClass =
  'relative inline-flex h-8 w-[3.25rem] shrink-0 cursor-pointer items-center rounded-full border border-neutral-300 bg-neutral-200 p-0.5 transition-colors dark:border-neutral-600 dark:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-800 focus-visible:ring-offset-2 dark:focus-visible:ring-neutral-100 dark:focus-visible:ring-offset-neutral-950';
---
<header class="fixed w-full top-0 z-50 bg-neutral-50/90 backdrop-blur-md shadow-sm transition-all duration-300 dark:bg-neutral-950/90 dark:shadow-neutral-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink min-w-0 flex items-center">
        <a href="#inicio" aria-label="Ir al inicio" class="text-base sm:text-lg md:text-2xl font-bold text-neutral-700 tracking-tight truncate max-w-[55vw] sm:max-w-none dark:text-neutral-100">Glamping San Francisco</a>
      </div>
      
      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-8">
        <a href="#galeria" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Galería</a>
        <a href="#servicios" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Servicios</a>
        <a href="#experiencias" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Experiencias</a>
        <a href="#precios" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Precios</a>
        <a href="#ubicacion" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Ubicación</a>
        <a href="#contacto" class="text-neutral-700 hover:text-neutral-600 font-medium transition-colors dark:text-neutral-300 dark:hover:text-neutral-100">Contacto</a>
      </nav>

      <div class="hidden md:flex items-center gap-3">
        <button
          type="button"
          data-theme-toggle
          role="switch"
          aria-checked="false"
          aria-label="Cambiar a modo oscuro"
          class={themeToggleClass}
        >
          <span class="pointer-events-none inline-flex h-6 w-6 items-center justify-center rounded-full bg-white text-neutral-700 shadow-sm transition-transform dark:translate-x-[1.35rem] dark:bg-neutral-950 dark:text-neutral-100">
            <Icon name="sun" class="h-3.5 w-3.5 dark:hidden" />
            <Icon name="moon" class="hidden h-3.5 w-3.5 dark:block" />
          </span>
        </button>
        <a
          href={SITE.airbnbUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-airbnb-link
          data-airbnb-source="navbar"
          class="bg-neutral-800 text-white px-6 py-2.5 rounded-full font-medium hover:bg-neutral-700 transition-all hover:scale-105 shadow-md dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
        >
          Reservar
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center gap-2">
        <button
          type="button"
          data-theme-toggle
          role="switch"
          aria-checked="false"
          aria-label="Cambiar a modo oscuro"
          class={themeToggleClass}
        >
          <span class="pointer-events-none inline-flex h-6 w-6 items-center justify-center rounded-full bg-white text-neutral-700 shadow-sm transition-transform dark:translate-x-[1.35rem] dark:bg-neutral-950 dark:text-neutral-100">
            <Icon name="sun" class="h-3.5 w-3.5 dark:hidden" />
            <Icon name="moon" class="hidden h-3.5 w-3.5 dark:block" />
          </span>
        </button>
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex items-center justify-center min-h-[44px] min-w-[44px] text-neutral-800 hover:text-neutral-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-800 focus-visible:ring-offset-2 rounded-md dark:text-neutral-100 dark:hover:text-neutral-300 dark:focus-visible:ring-neutral-100 dark:focus-visible:ring-offset-neutral-950"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden md:hidden bg-neutral-50 border-t border-neutral-200 dark:bg-neutral-950 dark:border-neutral-800">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="#galeria" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Galería</a>
      <a href="#servicios" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Servicios</a>
      <a href="#experiencias" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Experiencias</a>
      <a href="#precios" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Precios</a>
      <a href="#ubicacion" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Ubicación</a>
      <a href="#contacto" class="flex items-center min-h-[44px] px-3 py-2 text-neutral-800 font-medium hover:bg-neutral-50 hover:text-neutral-700 rounded-md dark:text-neutral-100 dark:hover:bg-neutral-800 dark:hover:text-white">Contacto</a>
      <a
        href={SITE.airbnbUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-airbnb-link
        data-airbnb-source="navbar-mobile"
        class="flex items-center justify-center min-h-[44px] px-3 py-2 mt-4 text-center bg-neutral-800 text-white hover:bg-neutral-700 rounded-full font-medium shadow-md transition-colors dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
      >
        Reservar en Airbnb
      </a>
    </div>
  </div>
</header>

<script>
  import { initThemeToggles } from '../scripts/theme';

  initThemeToggles();

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
    });
    
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

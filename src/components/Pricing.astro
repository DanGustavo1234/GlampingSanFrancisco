---
import { SITE } from '../config/site';
import IconBox from './ui/IconBox.astro';

const plans = [
  {
    name: 'Reserva tu Experiencia',
    price: 'Desde $50',
    features: [
      'Cocina equipada',
      'Sala y comedor',
      'Cama Queen',
      'Baño completo privado',
      'Jacuzzi privado',
      'Vista a las montañas',
      'Capacidad hasta 4 personas',
    ],
  },
];
---

<section id="precios" class="py-16 sm:py-20 lg:py-24 bg-neutral-50 scroll-mt-20 dark:bg-neutral-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-4 dark:text-neutral-50">Tu Escapada Perfecta</h2>
    </div>

    <div class="flex justify-center">
      {
        plans.map((plan) => (
          <div class="relative bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-neutral-200 shadow-xl hover:shadow-2xl transition-shadow max-w-xl w-full dark:bg-neutral-900 dark:border-neutral-800">
            <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 text-center mb-4 dark:text-neutral-50">
              {plan.name}
            </h3>
            <div class="text-center mb-8">
              <span class="text-4xl sm:text-5xl font-extrabold text-neutral-600 dark:text-neutral-300">{plan.price}</span>
              <span class="text-neutral-500 dark:text-neutral-400">/noche</span>
            </div>

            <ul class="space-y-4 mb-8">
              {
                plan.features.map((feature) => (
                  <li class="flex items-center text-neutral-700 gap-3 dark:text-neutral-300">
                    <IconBox name="check" size="xs" />
                    {feature}
                  </li>
                ))
              }
            </ul>

            <div class="space-y-3">
              <a
                href={SITE.airbnbUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-airbnb-link
                data-airbnb-source="pricing"
                class="block w-full text-center py-3 rounded-full font-semibold transition-all hover:scale-105 bg-neutral-800 text-white hover:bg-neutral-700 min-h-[48px] flex items-center justify-center dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
              >
                Reservar hospedaje en Airbnb
              </a>
              <a
                href="#experiencias"
                class="block w-full text-center py-3 rounded-full font-semibold transition-all hover:scale-105 border border-neutral-300 text-neutral-800 hover:bg-neutral-50 min-h-[48px] flex items-center justify-center dark:border-neutral-600 dark:text-neutral-100 dark:hover:bg-neutral-800"
              >
                Ver experiencias
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

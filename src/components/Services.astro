---
import IconBox from './ui/IconBox.astro';

const services = [
  {
    title: 'Café de Cortesía',
    description:
      'Te ofrecemos café molido de origen local para que prepares, disfrutes y conectes con la esencia de la región.',
    icon: 'coffee' as const,
  },
  {
    title: 'Jacuzzi Privado',
    description: 'Confort, privacidad y una vista natural incomparable desde tu jacuzzi.',
    icon: 'zap' as const,
  },
  {
    title: 'Fogatas Nocturnas',
    description: 'Zona asignada para fogatas, incluye kit de malvaviscos y leña para cada noche.',
    icon: 'flame' as const,
  },
];
---

<section id="servicios" class="py-16 sm:py-20 lg:py-24 bg-neutral-50 scroll-mt-20 dark:bg-neutral-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-4 dark:text-neutral-50">Servicios Exclusivos</h2>
      <p class="text-neutral-700 max-w-2xl mx-auto text-base sm:text-lg dark:text-neutral-300">
        Creamos la atmósfera perfecta para tu desconexión con detalles pensados en ti.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-10">
      {
        services.map((service) => (
          <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-neutral-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group dark:bg-neutral-900 dark:border-neutral-800">
            <IconBox name={service.icon} size="md" hover class="mb-6" />
            <h3 class="text-xl sm:text-2xl font-semibold text-neutral-900 mb-3 dark:text-neutral-50">{service.title}</h3>
            <p class="text-neutral-700 leading-relaxed dark:text-neutral-300">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

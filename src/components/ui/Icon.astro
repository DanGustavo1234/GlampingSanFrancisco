---
import { ICONS, type IconName } from '../../data/icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: string;
}

const { name, class: className = 'w-5 h-5', strokeWidth = '1.5' } = Astro.props;
const path = ICONS[name];
---

<svg
  class={className}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={strokeWidth} d={path} />
</svg>

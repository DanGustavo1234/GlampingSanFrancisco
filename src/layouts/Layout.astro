---
import '../styles/global.css';
import { publicUrl } from '../lib/public-url';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Glamping moderno y natural. Reserva tu experiencia." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={publicUrl('favicon.svg')} />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NV19862TEZ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-NV19862TEZ');
		</script>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					var dark = stored === 'dark' || (stored !== 'light' && prefersDark);
					if (dark) document.documentElement.classList.add('dark');
					document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="bg-neutral-50 text-neutral-900 font-sans antialiased overflow-x-hidden dark:bg-neutral-950 dark:text-neutral-50">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-neutral: #52525b;
		--color-neutral-dark: #27272a;
		--color-neutral-light: #f4f4f5;
	}

	html.dark {
		--color-neutral: #a1a1aa;
		--color-neutral-dark: #fafafa;
		--color-neutral-light: #18181b;
	}
</style>
